{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/render?type=home"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/render?type=article&slug=:slug"
    },
    {
      "source": "/destination/:slug",
      "destination": "/api/render?type=destination&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/render?type=blog"
    },
    {
      "source": "/:lang(ar|fr|es)",
      "destination": "/api/render?type=home&lang=:lang"
    },
    {
      "source": "/:lang(ar|fr|es)/article/:slug",
      "destination": "/api/render?type=article&lang=:lang&slug=:slug"
    },
    {
      "source": "/:lang(ar|fr|es)/destination/:slug",
      "destination": "/api/render?type=destination&lang=:lang&slug=:slug"
    },
    {
      "source": "/:lang(ar|fr|es)/blog",
      "destination": "/api/render?type=blog&lang=:lang"
    },
    {
      "source": "/flights",
      "destination": "/api/route-page"
    },
    {
      "source": "/flights/:route",
      "destination": "/api/route-page?route=:route"
    },
    {
      "source": "/:lang(ar|fr|es)/flights",
      "destination": "/api/route-page?lang=:lang"
    },
    {
      "source": "/:lang(ar|fr|es)/flights/:route",
      "destination": "/api/route-page?lang=:lang&route=:route"
    },
    {
      "source": "/car",
      "destination": "/api/car-page"
    },
    {
      "source": "/:lang(ar|fr|es)/car",
      "destination": "/api/car-page?lang=:lang"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/destination/dubai-uae",
      "destination": "/destination/dubai",
      "permanent": true
    },
    {
      "source": "/destination/france-paris",
      "destination": "/destination/paris",
      "permanent": true
    },
    {
      "source": "/article/traveler-health-guide-avoiding-diseases",
      "destination": "/article/travel-health-guide",
      "permanent": true
    },
    {
      "source": "/article/customs-guide-travel",
      "destination": "/article/customs-regulations-guide",
      "permanent": true
    },
    {
      "source": "/:lang(ar|fr|es)/destination/dubai-uae",
      "destination": "/:lang/destination/dubai",
      "permanent": true
    },
    {
      "source": "/:lang(ar|fr|es)/destination/france-paris",
      "destination": "/:lang/destination/paris",
      "permanent": true
    },
    {
      "source": "/:lang(ar|fr|es)/article/traveler-health-guide-avoiding-diseases",
      "destination": "/:lang/article/travel-health-guide",
      "permanent": true
    },
    {
      "source": "/:lang(ar|fr|es)/article/customs-guide-travel",
      "destination": "/:lang/article/customs-regulations-guide",
      "permanent": true
    }
  ],
  "functions": {
    "api/route-page.js": {
      "includeFiles": "api/_data/**"
    },
    "api/sitemap.js": {
      "includeFiles": "api/_data/**"
    },
    "api/car-page.js": {
      "includeFiles": "api/_data/**"
    }
  }
}
